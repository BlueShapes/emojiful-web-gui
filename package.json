{
  "name": "emojiful-web-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "astro dev --root web --host 127.0.0.1",
    "build": "astro build --root web",
    "preview": "astro preview --root web --host 127.0.0.1",
    "dev:workers": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "check": "astro check --root web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:workers": "playwright test --config playwright.workers.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "fflate": "0.8.3",
    "lucide-react": "1.53.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.151.0"
  }
}
